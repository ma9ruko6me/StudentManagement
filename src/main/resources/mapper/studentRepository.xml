<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="raisetech.StudentManagement.repository.StudentRepository">

  <!-- 受講生の全件検索 -->
  <select id="search" resultType="raisetech.StudentManagement.data.Student">
    SELECT * FROM students
  </select>

  <!-- 受講生の検索 -->
  <select id="searchStudent" resultType="raisetech.StudentManagement.data.Student">
    SELECT * FROM students WHERE id = #{id}
  </select>

  <!-- 受講生の条件検索 -->
  <select id="searchStudentRows" resultType="raisetech.StudentManagement.dto.result.StudentCourseApplicationRow">
    SELECT
    s.id AS studentId,
    s.name,
    s.furigana,
    s.nickname,
    s.email,
    s.area,
    s.age,
    s.gender,
    s.remark,
    s.is_deleted AS isDeleted,

    sc.id AS courseId,
    sc.course_name AS courseName,
    sc.course_start_at AS courseStartAt,
    sc.course_end_at AS courseEndAt,

    ca.id AS applicationId,
    ca.application_status AS applicationStatus

    FROM students s

    LEFT JOIN students_courses sc
    ON s.id = sc.student_id

    LEFT JOIN course_applications ca
    ON sc.id = ca.course_id

    <where>

      <choose>

        <!--AND検索-->
        <when test="searchType != null and searchType.name() == 'AND'">

          <if test="studentSearchCondition != null and studentSearchCondition.keyword != null and studentSearchCondition.keyword !=''">
            <trim prefix="AND (" suffix=")" prefixOverrides="OR">
              OR s.name LIKE CONCAT('%', #{studentSearchCondition.keyword}, '%')
              OR s.furigana LIKE CONCAT('%', #{studentSearchCondition.keyword}, '%')
            </trim>
          </if>

          <if test="studentSearchCondition != null and studentSearchCondition.ageFrom != null">
            AND s.age >= #{studentSearchCondition.ageFrom}
          </if>

          <if test="studentSearchCondition != null and studentSearchCondition.ageTo != null">
            AND s.age &lt;= #{studentSearchCondition.ageTo}
          </if>

          <if test="studentSearchCondition != null and studentSearchCondition.area != null and studentSearchCondition.area !=''">
            AND s.area = #{studentSearchCondition.area}
          </if>

          <if test="studentSearchCondition != null and studentSearchCondition.gender != null and studentSearchCondition.gender !=''">
            AND s.gender = #{studentSearchCondition.gender}
          </if>

          <if test="studentSearchCondition != null and studentSearchCondition.isDeleted != null">
            AND s.is_deleted = #{studentSearchCondition.isDeleted}
          </if>

          <if test="courseSearchCondition != null and courseSearchCondition.courseName != null and courseSearchCondition.courseName !=''">
            AND sc.course_name = #{courseSearchCondition.courseName}
          </if>

          <if test="applicationSearchCondition != null and applicationSearchCondition.applicationStatus != null">
            AND ca.application_status = #{applicationSearchCondition.applicationStatus}
          </if>

        </when>

        <!--OR検索-->
        <when test="searchType != null and searchType.name() == 'OR'">
          <if test="studentSearchCondition != null and studentSearchCondition.keyword != null and studentSearchCondition.keyword !=''">
            <trim prefix="OR (" suffix=")" prefixOverrides="OR">
              OR s.name LIKE CONCAT('%', #{studentSearchCondition.keyword}, '%')
              OR s.furigana LIKE CONCAT('%', #{studentSearchCondition.keyword}, '%')
            </trim>
          </if>

          <if test="studentSearchCondition != null and studentSearchCondition.ageFrom != null">
            OR s.age >= #{studentSearchCondition.ageFrom}
          </if>

          <if test="studentSearchCondition != null and studentSearchCondition.ageTo != null">
            OR s.age &lt;= #{studentSearchCondition.ageTo}
          </if>

          <if test="studentSearchCondition != null and studentSearchCondition.area != null and studentSearchCondition.area !=''">
            OR s.area = #{studentSearchCondition.area}
          </if>

          <if test="studentSearchCondition != null and studentSearchCondition.gender != null and studentSearchCondition.gender !=''">
            OR s.gender = #{studentSearchCondition.gender}
          </if>

          <if test="studentSearchCondition != null and studentSearchCondition.isDeleted != null">
            OR s.is_deleted = #{studentSearchCondition.isDeleted}
          </if>

          <if test="courseSearchCondition != null and courseSearchCondition.courseName != null and courseSearchCondition.courseName !=''">
            OR sc.course_name = #{courseSearchCondition.courseName}
          </if>

          <if test="applicationSearchCondition != null and applicationSearchCondition.applicationStatus != null">
            OR ca.application_status = #{applicationSearchCondition.applicationStatus}
          </if>

        </when>

      </choose>

    </where>

    <!--ソート機能-->
    <if test="sortKey != null and sortOrder != null">
      ORDER BY ${sortKey.column} ${sortOrder.value}
    </if>

    <if test="sortKey == null and sortOrder == null">
      ORDER BY s.id ASC
    </if>

  </select>

  <!-- 受講生コース情報の全件検索 -->
  <select id="searchStudentCourseList" resultType="raisetech.StudentManagement.data.StudentCourse">
    SELECT * FROM students_courses
  </select>

  <!-- 受講生IDに紐づく受講生コース情報の検索 -->
  <select id="searchStudentCourseByStudentId" resultType="raisetech.StudentManagement.data.StudentCourse">
    SELECT * FROM students_courses WHERE student_id = #{studentId}
  </select>

  <!-- 受講生コースIDに紐づく受講生コース情報の検索 -->
  <select id="searchStudentCourseByCourseId" resultType="raisetech.StudentManagement.data.StudentCourse">
    SELECT * FROM students_courses WHERE id = #{courseId}
  </select>

  <!--受講生コースの申込状況の全件検索-->
  <select id="searchCourseApplicationList" resultType="raisetech.StudentManagement.data.CourseApplication">
    SELECT * FROM course_applications
  </select>

  <!--受講生IDに紐づく受講生コースの申込状況の検索-->
  <select id="searchCourseApplicationByStudentId" resultType="raisetech.StudentManagement.data.CourseApplication">
    SELECT * FROM course_applications WHERE student_id = #{studentId}
  </select>

  <!--受講生コースIDに紐づく受講生コースの申込状況の検索-->
  <select id="searchCourseApplicationByCourseId" resultType="raisetech.StudentManagement.data.CourseApplication">
    SELECT * FROM course_applications WHERE course_id = #{courseId}
  </select>

  <!-- 受講生の登録 -->
  <insert id="registerStudent" useGeneratedKeys = "true" keyProperty = "id">
    INSERT INTO students (name,furigana,nickname,age,email,area,gender,remark,is_deleted) VALUES (#{name},#{furigana},#{nickname},#{age},#{email},#{area},#{gender},#{remark},0)
  </insert>

  <!-- 受講生コース情報の登録 -->
  <insert id="registerStudentCourse" useGeneratedKeys = "true" keyProperty = "id">
    INSERT INTO students_courses (student_id,course_name,course_start_at,course_end_at) VALUES (#{studentId},#{courseName},#{courseStartAt},#{courseEndAt})
  </insert>

  <!--受講生コースの申込状況の登録-->
  <insert id="registerCourseApplication" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO course_applications (student_id,course_id,application_status) VALUES(#{studentId},#{courseId},#{applicationStatus})
  </insert>

  <!-- 受講生の更新 -->
  <update id="updateStudent">
    UPDATE students SET  name = #{name},furigana = #{furigana},nickname = #{nickname},age = #{age},email = #{email},area = #{area},gender = #{gender},remark = #{remark},is_deleted = #{isDeleted} WHERE id = #{id}
  </update>

  <!-- 受講生コース情報の更新 -->
  <update id="updateStudentCourse">
    UPDATE students_courses SET course_name = #{courseName} WHERE id = #{id}
  </update>

  <!--受講生コースの申込状況の更新-->
  <update id="updateCourseApplication">
    UPDATE course_applications SET application_status = #{applicationStatus} WHERE id = #{id}
  </update>

</mapper>